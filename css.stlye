:root {
  --bg: #0b1020;
  --text: #f5f7ff;
  --muted: #9ba5c2;
  --card: rgba(21, 29, 55, 0.68);
  --border: rgba(255, 255, 255, 0.13);
  --input: rgba(255, 255, 255, 0.06);
  --accent: #9a7bff;
  --accent-2: #67d5ff;
  --success: #63dbb1;
  --danger: #ff8c9b;
}

[data-theme="light"] {
  --bg: #eef2ff;
  --text: #17203b;
  --muted: #65708c;
  --card: rgba(255, 255, 255, 0.7);
  --border: rgba(43, 53, 90, 0.14);
  --input: rgba(255, 255, 255, 0.8);
  --accent: #6d4cff;
  --accent-2: #23a8d6;
  --success: #2db876;
  --danger: #d63447;
}

* {
  box-sizing: border-box;
  margin: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  background:
    radial-gradient(circle at 15% 10%, rgba(111, 75, 255, .25), transparent 31rem),
    radial-gradient(circle at 90% 90%, rgba(31, 187, 230, .18), transparent 28rem),
    var(--bg);
  transition: background .3s, color .3s;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .15;
  background-image:
    linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: linear-gradient(to bottom, black, transparent);
}

.page-shell {
  max-width: 1180px;
  min-height: 100vh;
  padding: 28px 34px 22px;
  margin: auto;
  display: flex;
  flex-direction: column;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  color: var(--text);
  text-decoration: none;
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: .12em;
}

.brand span {
  color: var(--accent-2);
  margin-right: 8px;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.theme-toggle,
.nav-button {
  border: 1px solid transparent;
  color: var(--muted);
  background: transparent;
  padding: 10px 15px;
  border-radius: 12px;
  cursor: pointer;
  font: inherit;
  transition: .2s;
}

.theme-toggle {
  color: var(--text);
  font-size: 1.2rem;
}

.nav-button:hover,
.nav-button.active {
  color: var(--text);
  background: var(--input);
  border-color: var(--border);
}

.auth-layout {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 460px;
  align-items: center;
  gap: 100px;
  padding: 70px 5% 40px;
}

.eyebrow {
  color: var(--accent-2);
  text-transform: uppercase;
  letter-spacing: .16em;
  font-size: .71rem;
  font-weight: 700;
}

.intro h1 {
  margin: 18px 0;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 1.04;
  letter-spacing: -.06em;
}

.intro h1 span {
  color: var(--accent);
}

.intro-copy {
  max-width: 440px;
  color: var(--muted);
  line-height: 1.7;
  font-size: 1.05rem;
}

.trust {
  margin-top: 36px;
  color: var(--muted);
  font-size: .86rem;
}

.avatars {
  color: var(--accent-2);
  margin-right: 13px;
}

.auth-card {
  padding: 38px;
  border: 1px solid var(--border);
  border-radius: 28px;
  background: var(--card);
  box-shadow:
    0 25px 80px rgba(0,0,0,.25),
    inset 0 1px rgba(255,255,255,.12);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  position: relative;
  overflow: hidden;
}

.auth-card::before {
  content: "";
  position: absolute;
  width: 180px;
  height: 180px;
  right: -100px;
  top: -100px;
  background: var(--accent);
  filter: blur(50px);
  opacity: .3;
}

.form-panel {
  position: relative;
  transition: .25s;
}

.hidden {
  display: none;
}

.form-heading {
  margin-bottom: 26px;
}

.form-heading h2 {
  margin: 7px 0;
  font-size: 2rem;
  letter-spacing: -.04em;
}

.form-heading p:last-child {
  color: var(--muted);
  font-size: .9rem;
}

form {
  display: grid;
  gap: 16px;
}

label {
  display: grid;
  gap: 8px;
  color: var(--muted);
  font-size: .82rem;
  font-weight: 500;
}

input[type="email"],
input[type="password"],
input[type="text"] {
  width: 100%;
  border: 1px solid var(--border);
  outline: 0;
  border-radius: 12px;
  padding: 13px 14px;
  color: var(--text);
  background: var(--input);
  font: inherit;
  transition: .2s;
}

input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(154,123,255,.15);
}

input::placeholder {
  color: var(--muted);
  opacity: .7;
}

.password-field {
  position: relative;
}

.password-field input {
  padding-right: 42px;
}

.show-password {
  position: absolute;
  top: 8px;
  right: 8px;
  border: 0;
  padding: 7px;
  color: var(--muted);
  background: transparent;
  cursor: pointer;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.check {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: .78rem;
}

.check input {
  accent-color: var(--accent);
}

.muted-link,
.terms a {
  color: var(--muted);
  font-size: .78rem;
  text-decoration: none;
}

.muted-link:hover,
.terms a:hover {
  text-decoration: underline;
}

.primary-button {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 0;
  border-radius: 12px;
  padding: 14px 17px;
  color: white;
  background: linear-gradient(110deg, var(--accent), #6251dc);
  font: 600 1rem "DM Sans", sans-serif;
  cursor: pointer;
  box-shadow: 0 8px 22px rgba(109,76,255,.24);
  transition: transform .2s, filter .2s;
}

.primary-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.1);
}

.primary-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.form-message {
  min-height: 18px;
  color: var(--danger);
  font-size: .8rem;
}

.form-message.success {
  color: var(--success);
}

.switch-copy {
  margin-top: 24px;
  color: var(--muted);
  font-size: .82rem;
  text-align: center;
}

.text-button {
  border: 0;
  padding: 0;
  color: var(--accent-2);
  background: transparent;
  font: inherit;
  cursor: pointer;
}

.terms span {
  line-height: 1.5;
}

footer {
  color: var(--muted);
  font-size: .75rem;
  text-align: center;
}

/* Dashboard Styles */
.dashboard-shell {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 0;
  min-height: 100vh;
}

.sidebar {
  background: var(--card);
  border-right: 1px solid var(--border);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 32px;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
}

.sidebar-brand {
  color: var(--text);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: .1em;
}

.sidebar-brand span {
  color: var(--accent-2);
}

.sidebar-nav {
  display: grid;
  gap: 8px;
}

.sidebar-link {
  color: var(--muted);
  text-decoration: none;
  padding: 12px 16px;
  border-radius: 12px;
  transition: .2s;
  border: 1px solid transparent;
  font-size: .9rem;
}

.sidebar-link:hover {
  background: var(--input);
  color: var(--text);
}

.sidebar-link.active {
  background: var(--input);
  color: var(--accent-2);
  border-color: var(--accent-2);
}

.main-content {
  padding: 28px 34px;
  overflow-y: auto;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
}

.dashboard-header h1 {
  font-size: 2rem;
}

.user-menu {
  display: flex;
  align-items: center;
  gap: 16px;
}

.user-info {
  text-align: right;
}

.user-name {
  font-weight: 600;
}

.user-email {
  color: var(--muted);
  font-size: .85rem;
}

.btn-logout {
  padding: 8px 16px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  transition: .2s;
  text-decoration: none;
}

.btn-logout:hover {
  background: var(--danger);
  color: white;
  border-color: var(--danger);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
  margin-bottom: 32px;
}

.stat-card {
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--card);
  backdrop-filter: blur(22px);
}

.stat-label {
  color: var(--muted);
  font-size: .85rem;
  margin-bottom: 12px;
}

.stat-value {
  font-size: 2rem;
  font-weight: 700;
  color: var(--accent);
}

.content-section {
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--card);
  backdrop-filter: blur(22px);
}

.content-section h2 {
  margin-bottom: 20px;
  font-size: 1.5rem;
}

.users-table {
  width: 100%;
  border-collapse: collapse;
}

.users-table th {
  text-align: left;
  padding: 12px;
  border-bottom: 1px solid var(--border);
  color: var(--muted);
  font-size: .85rem;
  font-weight: 600;
}

.users-table td {
  padding: 12px;
  border-bottom: 1px solid var(--border);
}

.users-table tbody tr:hover {
  background: var(--input);
}

.badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 6px;
  font-size: .75rem;
  font-weight: 600;
}

.badge.user {
  background: var(--accent);
  color: white;
}

.badge.admin {
  background: var(--accent-2);
  color: white;
}

@media (max-width: 800px) {
  .page-shell {
    padding: 22px 18px;
  }

  .auth-layout {
    grid-template-columns: 1fr;
    gap: 35px;
    padding: 60px 0 30px;
  }

  .intro {
    text-align: center;
  }

  .intro-copy {
    margin: auto;
  }

  .trust {
    margin-top: 22px;
  }

  .auth-card {
    width: 100%;
    max-width: 500px;
    margin: auto;
  }

  .dashboard-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: relative;
    height: auto;
    border-bottom: 1px solid var(--border);
  }

  .main-content {
    padding: 20px;
  }
}

@media (max-width: 480px) {
  .nav-button {
    padding: 8px;
    font-size: .78rem;
  }

  .auth-card {
    padding: 26px 20px;
    border-radius: 22px;
  }

  .intro h1 {
    font-size: 2.8rem;
  }

  .dashboard-header {
    flex-direction: column;
    gap: 16px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }
}